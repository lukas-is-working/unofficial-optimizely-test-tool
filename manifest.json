{
  "manifest_version": 3,
  "name": "Unofficial Optimizely Test Tool",
  "version": "1.0.1",
  "description": "Unofficial community tool for testing Optimizely experiments and events on local and remote shop environments.",
  "permissions": ["storage", "cookies", "activeTab", "scripting", "clipboardWrite", "windows", "declarativeNetRequestWithHostAccess", "tabs"],
  "host_permissions": ["<all_urls>", "https://api.optimizely.com/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Unofficial Optimizely Test Tool",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-128.png",
      "32": "icons/icon-128.png",
      "48": "icons/icon-128.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-128.png",
    "32": "icons/icon-128.png",
    "48": "icons/icon-128.png",
    "128": "icons/icon-128.png"
  },
  "options_page": "options.html",
  "incognito": "spanning",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
